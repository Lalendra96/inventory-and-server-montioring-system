APP_NAME="THP HIMU ICT Operations"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL is the supported production database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=thp_himu_ict
DB_USERNAME=thp_himu
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true once HTTPS is enabled.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="himu-ict@thp.local"
MAIL_FROM_NAME="${APP_NAME}"

# Use a dedicated random secret in production, separate from APP_KEY.
AUDIT_HMAC_KEY=

# First deployment administrator. Change/remove these after initial seeding.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL=admin@thp.local
SEED_ADMIN_PASSWORD="CHANGE_THIS_BEFORE_SEEDING"

# Server monitoring SSH timeouts (seconds)
SERVER_MONITOR_SSH_TIMEOUT=8
SERVER_MONITOR_COMMAND_TIMEOUT=12
SERVER_MONITOR_REMOTE_HELPER=/usr/local/sbin/himu-opsctl
